# =============================================================================
# Odoo 17 Environment Variables
# Repository: guilhermePiauhy/odoo-piauhy
#
# USAGE:
#   cp .env.example .env
#   # Edit .env with your real values
#   # NEVER commit .env to version control
#
# Both docker-compose.prod.yml and docker-compose.dev.yml read from .env
# automatically when placed in the same directory.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------

# Name of the default Odoo database created on first run.
POSTGRES_DB=odoo

# PostgreSQL superuser for the Odoo connection.
POSTGRES_USER=odoo

# Strong random password — generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# -----------------------------------------------------------------------------
# Odoo master (admin) password
# Controls access to the /web/database manager.
# Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# After generating, update config/odoo.conf admin_passwd with this value
# OR inject it via an entrypoint script.
# -----------------------------------------------------------------------------
ODOO_ADMIN_PASSWD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# -----------------------------------------------------------------------------
# Odoo — optional runtime overrides
# The docker-compose files already pass HOST/PORT/USER/PASSWORD from the
# POSTGRES_* variables above. These are provided here for documentation.
# -----------------------------------------------------------------------------
# ODOO_DB_HOST=db
# ODOO_DB_PORT=5432
# ODOO_DB_USER=${POSTGRES_USER}
# ODOO_DB_PASSWORD=${POSTGRES_PASSWORD}

# -----------------------------------------------------------------------------
# Nginx / TLS (production only)
# Set your domain name here. Update nginx/odoo.conf server_name directives
# to match.
# -----------------------------------------------------------------------------
DOMAIN=odoo.example.com

# Path to TLS certificate files on the host (mounted into Nginx container).
# Certbot example:
#   TLS_CERT=/etc/letsencrypt/live/odoo.example.com/fullchain.pem
#   TLS_KEY=/etc/letsencrypt/live/odoo.example.com/privkey.pem
# Self-signed / custom CA:
TLS_CERT=./nginx/certs/fullchain.pem
TLS_KEY=./nginx/certs/privkey.pem

# -----------------------------------------------------------------------------
# SMTP — outgoing email (optional, can also be set in Odoo UI)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=your_smtp_password
# SMTP_SSL=False

# -----------------------------------------------------------------------------
# Odoo performance (production tuning)
# Override here to avoid editing config/odoo.conf directly.
# -----------------------------------------------------------------------------
# ODOO_WORKERS=4
# ODOO_MAX_CRON_THREADS=2
